# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# old site (local reference only)
/old-site-reference/

# third-party agent skills: restore with `npx skills experimental_install` (skills-lock.json)
/.claude/skills/design-taste-frontend/

# Astryx theme build outputs: regenerated by `npm run themes` (runs before dev and build).
# The *Theme.ts sources, zastitiTheme.doc.mjs, icons.tsx, audience.ts and src/astryx-themes.ts stay committed.
/src/themes/zastiti*/zastiti*.css
/src/themes/zastiti*/zastiti*.js
/src/themes/zastiti*/zastiti*.d.ts
